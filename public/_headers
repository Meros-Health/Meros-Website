# Served by Workers Static Assets. Without this every asset ships
# max-age=0, must-revalidate, and each page load revalidates every image.

# Static assets are served straight from the assets binding, which may not pass
# through the Worker's own header pass, so the two headers that are safe to send
# twice are repeated here. X-Frame-Options and the frame-ancestors CSP are
# deliberately not: a duplicated frame directive is treated as invalid by some
# browsers, and HTML always goes through the Worker, where next.config.ts sets
# the full set.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Next's build output is content-hashed by Next itself.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Rendered image variants carry a content hash in the name (lib/images/variants.cjs),
# so they can never go stale under an immutable year.
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Source images, logos and video are addressed by plain name, so a replaced
# file must be picked up within a day.
/images-web/*
  Cache-Control: public, max-age=86400
/logos/*
  Cache-Control: public, max-age=86400

# Email signature art. Mail clients and scanners refetch these on every
# open, so without a cache header each open is a full origin request.
# Plain names, so a replaced file still lands within a day.
/signature/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
/og/*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
