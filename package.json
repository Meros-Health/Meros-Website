{
  "name": "meros-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate:menu": "node scripts/validate-menu.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && tsc --noEmit && vitest run",
    "prebuild": "npm run validate:menu && vitest run",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "preview": "npm run validate:menu && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run validate:menu && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run validate:menu && opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "framer-motion": "^11.3.19",
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "next": "^15.3.4",
    "react": "^18",
    "react-dom": "^18",
    "zustand": "^4.5.4"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.12",
      "sharp": "^0.35.0"
    }
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "esbuild": "0.25.4",
    "eslint": "^9",
    "eslint-config-next": "^15.3.4",
    "jsdom": "^30.0.1",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.114.0"
  }
}
