.cursor/

# Paid / licensed brand assets: keep local only, never commit.
# Drop files into these folders for local dev and deploy builds.
/public/fonts/*
!/public/fonts/.gitkeep
!/public/fonts/README.md
!/public/fonts/Aetheria.woff
!/public/fonts/MontageSerif-Regular.woff2
!/public/fonts/Montage Serif Font Regular.otf
!/public/fonts/Satoshi-Light.woff2
!/public/images-web/**
!/public/logos/**

# Internal brand documents: sensitive, never commit to public repo.
/documents/

# Internal store operations, SOPs, and compliance records. Never commit to public repo.
/MEROS-resources/

# Catch-all for any .env variant not covered above
.env*

# graphify: local knowledge-graph cache and build artifacts, never commit
/graphify-out/

# cloudflare / opennext build artifacts
/.open-next/
/.wrangler/

# Internal infra/DNS runbook (account details, third-party vendor relationship). Never commit to public repo.
/docs/dns-cutover.md

# test output
/test-results/
/playwright-report/

# Committed template, no secrets
!.env.example
