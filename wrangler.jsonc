{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meros-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Workers Logs. Off by default, which meant a 2026-09-01 traffic surge could
  // only be read from zone analytics: shape but no source, and the Free plan
  // withholds client IP and ASN there. Request-level logs make the next one
  // answerable. Free tier covers well past this site's volume.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Order record, checkout idempotency, and catering inquiries (schema in
  // migrations/). One database, two unrelated tables: a second binding for one
  // table would be a second thing to create, migrate and forget about.
  //
  // Created 2026-08-31 in the merosyogurt account, region WNAM. The id is an
  // identifier, not a credential: access comes from this binding existing on
  // this Worker, so there is nothing here to leak.
  //
  // Local dev uses a separate miniflare copy, not this database. Apply
  // migrations to it once with:
  //   npx wrangler d1 migrations apply meros-orders --local
  //
  // Secrets are not listed here. The catering form's notification needs
  // RESEND_API_KEY, set once per environment with
  //   npx wrangler secret put RESEND_API_KEY
  // and read in lib/catering/runtime.ts. Local dev reads the same name from
  // .dev.vars (gitignored). Without it the notifier is null: inquiries are
  // still stored in D1, they just do not send an email.
  // Per-IP write limit for the catering form. The honeypot is a filter, not a
  // limit: a script that omits the field walks past it and every submission
  // becomes a durable row on the database below.
  //
  // In code rather than a Cloudflare dashboard rule because a Next server
  // action POSTs to the page's own URL, so there is no path a dashboard rule
  // could target that would not also catch ordinary navigation.
  //
  // namespace_id is a label local to this Worker, not an account resource, so
  // there is nothing to provision before a deploy. The binding is optional
  // everywhere it is read (lib/catering/rateLimit.ts): if it is missing the
  // form still works and the global hourly cap is the only guard.
  //
  // `period` accepts 10 or 60 only. Three a minute leaves room for a mistyped
  // email and a retry and stops a loop dead.
  "ratelimits": [
    {
      "name": "CATERING_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "meros-orders",
      "database_id": "c1eb6ab0-3cbf-4332-8b9e-5fc3f006109a",
      "migrations_dir": "migrations"
    }
  ],

  // Staff inventory board (/staff). Cloudflare Access fronts the path at the
  // edge (One-time PIN against an email allowlist); the routes re-verify the
  // Access JWT against the team domain's JWKS with these two values, so a
  // request that skips the edge (workers.dev, a policy mistake) dead-ends at
  // 403. All three must be present or lib/staff/runtime.ts keeps the portal
  // a 404: removing any one of them is the off switch.
  //
  // The AUD tag identifies the Access application; like the D1 id above it is
  // an identifier, not a credential.
  "vars": {
    "STAFF_PORTAL_ENABLED": "true",
    "STAFF_ACCESS_TEAM_DOMAIN": "merosyogurt.cloudflareaccess.com",
    "STAFF_ACCESS_AUD": "b9e5c311df029ad31e0bbcbf8e475237c26eec257282413701514cab4a205f2c"
  }
}
