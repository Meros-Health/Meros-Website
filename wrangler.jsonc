{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meros-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Order record + idempotency store (schema in migrations/). Before this
  // branch merges: create the database in the merosyogurt account
  // (`wrangler d1 create meros-orders` while logged into it), paste the real
  // database_id here, then `wrangler d1 migrations apply meros-orders --remote`.
  // The zero id below only ever backs local dev's miniflare copy.
  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "meros-orders",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
