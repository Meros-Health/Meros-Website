# Opens ordering: the cart's Checkout button, /checkout, and the checkout
# server action. Anything other than "true" keeps ordering closed.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Runtime kill switch, read per request on the Worker (not a build variable).
# Set ORDERING_DISABLED=true in the Worker's settings (or .dev.vars locally)
# to stop taking orders without a rebuild; remove it to resume. The checkout
# order record lives in the ORDERS_DB D1 binding (wrangler.jsonc); local dev
# needs `wrangler d1 migrations apply meros-orders --local` once.
